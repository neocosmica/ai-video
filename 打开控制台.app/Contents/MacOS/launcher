#!/bin/zsh
# Finder 双击入口：必要时拉起网页后端，再打开浏览器。
set -euo pipefail

HOST="127.0.0.1"
PORT="8790"
URL="http://${HOST}:${PORT}/"

# Contents/MacOS → Contents → .app → 仓库根
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$ROOT"

ready() {
  curl -fsS --max-time 1 "$URL" >/dev/null 2>&1
}

alert() {
  /usr/bin/osascript - "$1" "$2" <<'APPLESCRIPT' >/dev/null 2>&1 || true
on run argv
  display alert (item 1 of argv) message (item 2 of argv)
end run
APPLESCRIPT
}

notify() {
  /usr/bin/osascript - "$1" "$2" <<'APPLESCRIPT' >/dev/null 2>&1 || true
on run argv
  display notification (item 2 of argv) with title (item 1 of argv)
end run
APPLESCRIPT
}

if [[ ! -x "$ROOT/scripts/run.sh" ]]; then
  alert "打不开控制台" "找不到可执行的 scripts/run.sh。请确认「打开控制台.app」仍在仓库根目录。"
  exit 1
fi

if ready; then
  open "$URL"
  notify "小说 → 竖屏短剧" "控制台已在运行，已打开网页"
  exit 0
fi

# 在 Terminal 里前台跑服务（便于看日志、Ctrl+C 停止）；再等端口就绪后开浏览器
ROOT_Q="$(printf '%q' "$ROOT")"
/usr/bin/osascript <<EOF >/dev/null
tell application "Terminal"
  activate
  do script "cd ${ROOT_Q} && exec ./scripts/run.sh --host ${HOST} --port ${PORT}"
end tell
EOF

for _ in {1..90}; do
  if ready; then
    open "$URL"
    notify "小说 → 竖屏短剧" "控制台已启动"
    exit 0
  fi
  sleep 0.5
done

alert "控制台启动超时" "后端 45 秒内没有响应 ${URL}。请查看刚打开的 Terminal 窗口里的报错；也可先跑 ./scripts/run.sh doctor。"
exit 1
