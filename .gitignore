# 本机虚拟环境与安装产物（含指向 Caches 的符号链接）
.venv
.venv/
.venv-*/
**/.venv
**/.venv/
**/.venv-*/
**/__pycache__/
*.py[cod]
*.egg-info/
.python-version
.DS_Store

# 项目文件夹：顶层只入库小说、分镜、project.json；work/ 过程产物与成片不入库
projects/**
!projects/
!projects/*/
!projects/*/novel.txt
!projects/*/storyboard.json
!projects/*/project.json
projects/webui/

# 编辑器 / 缓存
.idea/
.vscode/
*.swp
.mypy_cache/
.ruff_cache/
.pytest_cache/
.cache/

# Hugging Face / 模型权重（绝不入库；setup 仍走镜像下载到本机缓存）
huggingface/
*.safetensors
*.bin
*.gguf
*.onnx
*.pt
*.pth
*.ckpt
*.ggml
*.npz*
*.h5
*.msgpack
*.ot
