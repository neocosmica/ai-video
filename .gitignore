tools/.x86_64-backup/
tools/.ffmpeg-dl/
tools/.ffprobe-dl/
tools/.ffmpeg-dl.*/
tools/.ffprobe-dl.*/
tools/*.wrong-arch.bak

# 网页控制台后台进程
